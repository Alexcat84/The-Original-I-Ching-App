{
  "name": "iching-oracle",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "generate:fallbacks:together": "node tools/fallback-tools/generate-prebuilt-fallbacks-together.mjs",
    "security:scan": "trivy fs --scanners secret,vuln --severity HIGH,CRITICAL --format json -o security/trivy-report.json . && semgrep --config p/typescript --config p/nextjs --config p/owasp-top-ten --json -o security/semgrep-report.json apps/web/src"
  },
  "dependencies": {
    "expo-linking": "6.3.1",
    "expo-constants": "16.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "expo-linking": "6.3.1",
    "@expo/config-plugins": "8.0.11",
    "brace-expansion@<1.1.13": "1.1.13",
    "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
    "picomatch@<2.3.2": "2.3.2",
    "picomatch@>=3.0.0 <3.0.2": "3.0.2",
    "postcss": ">=8.5.10"
  }
}
