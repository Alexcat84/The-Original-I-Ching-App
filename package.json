{
  "name": "iching-oracle",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "i18n:audit": "node tools/i18n-audit.mjs",
    "changelog:generate": "node scripts/generate-changelog.js",
    "changelog:update": "node scripts/update-changelog.js",
    "qa:mutation-output": "node scripts/mutation-output-qa.mjs",
    "verify:hexagram-fidelity": "node scripts/verify-hexagram-fidelity.mjs --gold=books --translator=wilhelm,legge",
    "verify:hexagram-fidelity:mirrors-deprecated": "node scripts/verify-hexagram-fidelity.mjs --gold=mirrors --translator=all",
    "pdf-gold:preflight": "node scripts/pdf-gold-preflight.mjs",
    "extract:gold:wilhelm-pdf": "node tools/extract-wilhelm-pdf.mjs",
    "extract:gold:legge-epub": "node tools/extract-legge-epub.mjs",
    "extract:gold:wilhelm-epub": "node tools/extract-wilhelm-epub.mjs",
    "audit:wilhelm-trigram-parma": "node tools/audit-wilhelm-trigram-parma.mjs",
    "extract:gold:legge-sbe-pdf": "node tools/extract-legge-sbe-pdf.mjs",
    "sync:legge-oracle-from-epub": "node tools/sync-legge-oracle-from-epub.mjs",
    "sync:wilhelm-oracle-from-epub": "node tools/sync-wilhelm-oracle-from-epub.mjs",
    "sync:legge-oracle-from-pdf-gold": "node tools/sync-legge-oracle-from-pdf-gold.mjs",
    "sync:wilhelm-oracle-from-pdf-gold": "node tools/sync-wilhelm-oracle-from-pdf-gold.mjs",
    "extract:gold:zhuxi-adler-pdf": "node tools/extract-zhuxi-adler-pdf.mjs",
    "audit:zhuxi-rules-vs-adler-gold": "node tools/audit-zhuxi-rules-vs-adler-gold.mjs",
    "extract:gold:huang-pdf": "node tools/extract-huang-pdf.mjs",
    "audit:huang-rules-vs-pdf-gold": "node tools/audit-huang-rules-vs-pdf-gold.mjs",
    "verify:hexagram-fidelity:pdf-wilhelm": "node scripts/verify-hexagram-fidelity.mjs --gold=pdf-wilhelm --translator=wilhelm",
    "verify:hexagram-fidelity:epub-wilhelm": "node scripts/verify-hexagram-fidelity.mjs --gold=epub-wilhelm --translator=wilhelm",
    "audit:wilhelm-pdf-vs-parma": "node scripts/audit-wilhelm-pdf-vs-parma.mjs",
    "audit:wilhelm-pdf-vs-epub": "node scripts/audit-wilhelm-pdf-vs-epub.mjs",
    "audit:legge-pdf-vs-epub": "node scripts/audit-legge-pdf-vs-epub.mjs",
    "verify:hexagram-fidelity:pdf-legge": "node scripts/verify-hexagram-fidelity.mjs --gold=pdf-legge --translator=legge",
    "verify:hexagram-fidelity:epub-legge": "node scripts/verify-hexagram-fidelity.mjs --gold=epub-legge --translator=legge",
    "scan:zhouyi-corruption": "node tools/scan-zhouyi-corruption.mjs",
    "check:hex-glyph-uniqueness": "node tools/check-hex-glyph-uniqueness.mjs",
    "verify:hexagram-fidelity:zhouyi-ctext": "node scripts/verify-hexagram-fidelity.mjs --gold=mirrors --translator=zhouyi",
    "ingest:zhouyi": "node tools/ingest-zhouyi-ctext.mjs",
    "ingest:wilhelm": "node tools/ingest-wilhelm.mjs",
    "ingest:legge": "node tools/ingest-legge-sacred.mjs",
    "ingest:translations": "npm run ingest:zhouyi && npm run ingest:wilhelm && npm run ingest:legge",
    "build:data": "node scripts/build-hexagrams.mjs",
    "clean": "turbo run clean",
    "generate:fallbacks:together": "node tools/fallback-tools/generate-prebuilt-fallbacks-together.mjs",
    "generate:together:iching-samples": "node tools/fallback-tools/generate-together-iching-samples.mjs",
    "security:scan": "trivy fs --scanners secret,vuln --severity HIGH,CRITICAL --skip-files .env --skip-files apps/web/.env.local --skip-dirs apps/mobile/android/app/build --ignorefile .trivyignore --format json -o security/trivy-report.json . && semgrep --config p/typescript --config p/nextjs --config p/owasp-top-ten --json -o security/semgrep-report.json apps/web/src"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "0.33.5",
    "@resvg/resvg-js-linux-x64-gnu": "2.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "glob": "10.5.0",
    "lodash": "4.18.1",
    "node-forge": "1.4.0",
    "turbo": "2.9.18",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "react-dom": "18.2.0",
    "@xmldom/xmldom@<=0.8.12": "0.9.10",
    "node-forge@<1.4.0": "1.4.0",
    "lodash@<4.18.0": "4.18.1",
    "glob@<10.5.0": "10.5.0",
    "brace-expansion@<1.1.13": "1.1.13",
    "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
    "picomatch@<2.3.2": "2.3.2",
    "picomatch@>=3.0.0 <3.0.2": "3.0.2",
    "expo-app-integrity": {
      "expo-build-properties": "~0.14.8",
      "expo-secure-store": "~14.2.4",
      "expo-device": "~7.1.4"
    }
  }
}
