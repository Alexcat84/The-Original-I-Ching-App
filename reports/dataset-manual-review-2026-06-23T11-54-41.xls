<Table>
<Row ss:StyleID="Header"><Cell><Data ss:Type="String">hex</Data></Cell><Cell><Data ss:Type="String">hex_name</Data></Cell><Cell><Data ss:Type="String">chinese</Data></Cell><Cell><Data ss:Type="String">translator</Data></Cell><Cell><Data ss:Type="String">field_key</Data></Cell><Cell><Data ss:Type="String">field_label</Data></Cell><Cell><Data ss:Type="String">section_order</Data></Cell><Cell><Data ss:Type="String">runtime_text</Data></Cell><Cell><Data ss:Type="String">epub_verbatim_text</Data></Cell><Cell><Data ss:Type="String">auto_match</Data></Cell><Cell><Data ss:Type="String">user_match</Data></Cell><Cell><Data ss:Type="String">user_notes</Data></Cell></Row>

