{
  "name": "@iching-oracle/mobile",
  "version": "3.3.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "node -e \"process.exit(0)\"",
    "eas-build-pre-install": "rm -rf android ios",
    "android:prebuild": "expo prebuild --platform android",
    "android:sync-native": "expo prebuild --platform android --no-install",
    "android:apk:release": "node ./scripts/assemble-android-release.js",
    "android:run:release": "expo run:android --variant release --no-bundler",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@iching-oracle/i18n": "file:../../packages/i18n",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@sentry/react-native": "^6.3.0",
    "eruda": "^3.4.3",
    "expo": "^53",
    "expo-app-integrity": "^0.3.0",
    "expo-application": "~6.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.8",
    "expo-device": "~7.1.4",
    "expo-file-system": "~18.1.11",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-media-library": "~17.1.7",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-purchases": "^10.3.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-webview": "13.13.5"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.0.10",
    "patch-package": "^8.0.1",
    "typescript": "~5.8.3"
  }
}
