{
  "name": "@iching-oracle/mobile",
  "version": "3.3.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "tsc --noEmit",
    "postinstall": "node ./scripts/fix-expo-app-integrity-gradle.js",
    "eas-build-pre-install": "rm -rf android ios",
    "android:prebuild": "expo prebuild --platform android",
    "android:sync-native": "expo prebuild --platform android --no-install",
    "android:apk:release": "node ./scripts/assemble-android-release.js",
    "android:run:release": "expo run:android --variant release --no-bundler",
    "ios": "expo run:ios",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iching-oracle/i18n": "file:../../packages/i18n",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "eruda": "^3.4.3",
    "expo": "^57",
    "expo-app-integrity": "^0.3.0",
    "expo-application": "~57.0.1",
    "expo-build-properties": "~57.0.5",
    "expo-constants": "~57.0.5",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-media-library": "~57.0.2",
    "expo-router": "~57.0.6",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.5",
    "expo-splash-screen": "~57.0.4",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "promise": "^8.3.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-edge-to-edge": "^1.6.0",
    "react-native-purchases": "^10.4.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-webview": "13.16.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    },
    "autolinking": {
      "exclude": [
        "react"
      ]
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "jsdom": "^26.1.0",
    "patch-package": "^8.0.1",
    "react-dom": "^19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  }
}
