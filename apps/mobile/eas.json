{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "buildArtifactPaths": [
        "android/app/build/outputs/mapping/**/mapping.txt"
      ],
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      }
    },
    "apk": {
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    },
    "verification": {
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
