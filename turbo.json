{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "ADMIN_EMAIL_ALLOWLIST",
    "RESEND_API_KEY",
    "TWO_FACTOR_EMAIL_FROM",
    "TWO_FACTOR_EMAIL_CODE_SECRET",
    "REVENUECAT_PROJECT_ID",
    "STRIPE_PUBLISHABLE_KEY",
    "STRIPE_SECRET_KEY"
  ],
  "globalPassThroughEnv": [
    "SKIP_GOOGLE_FONTS",
    "ANTHROPIC_API_KEY",
    "GROQ_API_KEY",
    "GROQ_MODEL",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "TOGETHER_API_KEY",
    "TOGETHER_IMAGE_MODEL",
    "TOGETHER_IMAGE_STEPS",
    "IMAGE_PROVIDER",
    "POLLINATIONS_MODEL",
    "POLLINATIONS_WIDTH",
    "POLLINATIONS_HEIGHT",
    "ADMIN_PANEL_KEY",
    "REVENUECAT_WEBHOOK_SECRET",
    "REVENUECAT_SECRET_KEY",
    "NEXT_PUBLIC_REVENUECAT_API_KEY",
    "NEXT_PUBLIC_APP_URL",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "TOTP_ENCRYPTION_KEY",
    "TURNSTILE_SECRET_KEY",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
