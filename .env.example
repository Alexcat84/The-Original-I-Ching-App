ANTHROPIC_API_KEY=
# Single model for all tiers (default: claude-sonnet-4-5). Use the exact ID from your Anthropic Console.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FAL_AI_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Server REST API (subscriber lookup). Enables POST /api/account/sync-billing alongside webhooks.
REVENUECAT_SECRET_KEY=
# Required for sync-billing + subscription UI: v2 customer subscriptions (Web Billing / Stripe).
REVENUECAT_PROJECT_ID=
# When v2 subscription list only returns opaque product ids (no entitlement lookup_key), map prod_… → tier JSON:
# REVENUECAT_PRODUCT_TIER_MAP={"prod559a41dadb":"oracle"}
# Exact value RevenueCat sends in the Authorization header (optional but strongly recommended in production).
REVENUECAT_WEBHOOK_SECRET=
# Web Billing / Purchases JS public key. Use the Supabase user UUID as app_user_id (synced from the client).
NEXT_PUBLIC_REVENUECAT_API_KEY=
# Optional SMS 2FA (disabled by default)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TOTP_ENCRYPTION_KEY=
# Email 2FA (Resend)
RESEND_API_KEY=
TWO_FACTOR_EMAIL_FROM="The Original I Ching App <no-reply@yourdomain.com>"
TWO_FACTOR_EMAIL_CODE_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Sin Supabase, los enlaces /r/ y /s/ se resuelven vía Upstash (mismas vars que rate limit).
# Cloudflare Turnstile (registration CAPTCHA). Server: secret; client widget: site key.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_URL=https://theoriginaliching.com
# Hosted checkout / Web Billing link (full URL, e.g. https://pay.rev.cat/sandbox/... or /purchase/...).
# Do NOT set this to the app homepage — CTAs will open the wrong page with ?app_user_id=... only.
NEXT_PUBLIC_PLANS_URL=
ADMIN_PANEL_KEY=
ADMIN_PANEL_KEY_HASH=
# Image generation: leave empty or use "auto" to pick the best available API (Together if TOGETHER_API_KEY is set).
# Force a provider: together | fal | gpt-image | pollinations | mock
# IMAGE_PROVIDER=
DEBUG_IMAGE_PROVIDER=
# If true, skip remote image APIs and use only the built-in sumi-e SVG (zero cost, always works).
# IMAGE_SUMI_ONLY=true
# Together.ai image generation (FLUX). With a valid key, images use your credits unless IMAGE_PROVIDER=mock or IMAGE_SUMI_ONLY=true.
TOGETHER_API_KEY=
# Paid default: fast Flux good for oracle scenes. Cheaper alts (check Together model list for exact IDs): SD XL, SD3, Juggernaut Lightning.
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Optional; 12–28 typical for Schnell (default 20)
# TOGETHER_IMAGE_STEPS=20
# For free strategy tests:
# IMAGE_PROVIDER=pollinations
# IMAGE_PROVIDER=fal
# IMAGE_PROVIDER=gpt-image
# IMAGE_PROVIDER=together
# POLLINATIONS_MODEL=flux
# POLLINATIONS_WIDTH=1344
# POLLINATIONS_HEIGHT=768
