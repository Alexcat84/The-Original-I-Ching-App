node_modules
# npm workspaces: only root package-lock.json is canonical
apps/*/package-lock.json
packages/*/package-lock.json
backend/*/package-lock.json
# Editor / agent local rules — never commit
.cursor
.claude
mcps
.turbo
dist
.next
out
build
*.tsbuildinfo
# Never commit environment files or templates (including .env.example).
.env
.env.*
*.log
.DS_Store
coverage
.expo
apps/mobile/.expo
apps/mobile/dist
.vercel
# tools/ and reports/ are local-only auxiliaries — not part of the deployable app.
# They remain on disk but are not committed to git.
#
# EXCEPTION: tools/fallback-tools/*.mjs. These generate and maintain the R2
# contingency image pool and carry real production logic (the prompt rotation is
# duplicated there, so the opener bug had to be fixed in both copies). Losing
# them to a disk failure would mean losing the ability to rebuild the pool, so
# the scripts are versioned. Their output/, node_modules/ and progress files are
# not. Note git cannot re-include a path whose parent directory is excluded,
# which is why this is `tools/*` and not `tools/`.
tools/*
!tools/fallback-tools/
tools/fallback-tools/*
!tools/fallback-tools/*.mjs
!tools/fallback-tools/package.json
!tools/fallback-tools/package-lock.json
!tools/fallback-tools/README.md
!tools/fallback-tools/USAGE.txt
reports/
# Claude Code / agent runtime state — never commit
.agents/
.tmp/
skills-lock.json
# Temporary local artifacts (root junk) — never commit
mis_logs.json
reportsnpm-audit-raw.json

# Keystore backups (never in the repo; the debug keystore itself is public by design)
*.keystore.bak

# AI-assistant caches / merge residues (EXT-SEC-02 P3 hygiene)
.cache/
*.orig

# Marketing assets: keep the guiones (posts.md/README) in git; images are local-only (~171 MB)
marketing/**/images/
