node_modules
# npm workspaces: only root package-lock.json is canonical
apps/*/package-lock.json
packages/*/package-lock.json
backend/*/package-lock.json
# Editor / agent local rules — never commit
.cursor
.claude
mcps
.turbo
dist
.next
out
build
*.tsbuildinfo
# Never commit environment files or templates (including .env.example).
.env
.env.*
*.log
.DS_Store
coverage
.expo
apps/mobile/.expo
apps/mobile/dist
.vercel
tools/output/
