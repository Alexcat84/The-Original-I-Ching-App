tools/source-pdfs/*.pdf
tools/source-pdfs/*.epub
# Temporary / local artifacts — never commit
*.keystore.bak
*.jks.bak
tools/fallback-tools/_sim*.mjs
# Claude Code / agent runtime state — never commit
.agents/
.tmp/
