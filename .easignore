# ── Node modules ──────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Build & cache outputs ─────────────────────────────────────────────────────
dist/
.next/
out/
build/
*.tsbuildinfo
.turbo/
apps/mobile/dist/
apps/mobile/.expo-export-test/

# ── Editor / agent / misc ─────────────────────────────────────────────────────
.cursor/
.claude/
mcps/
*.log
.DS_Store
coverage/
.vercel/
tools/

# ── Apps not needed for the mobile build ──────────────────────────────────────
apps/web/
backend/

# ── Expo native dirs (regenerated by expo prebuild / CNG) ─────────────────────
apps/mobile/android/
apps/mobile/ios/
apps/mobile/.expo/

# ── Signing artifacts ─────────────────────────────────────────────────────────
*.p8
*.p12
*.key
*.mobileprovision
apps/mobile/debug.keystore.bak
# Exclude all .jks but re-include the production keystore (credentialsSource: local)
*.jks
!apps/mobile/credentials/android/keystore.jks

# ── Env files — EXCEPT the mobile app's .env ──────────────────────────────────
# Root .gitignore excludes all .env which prevents Metro from baking EXPO_PUBLIC_*
# vars into the JS bundle. apps/mobile/.env must reach the EAS build server.
.env
.env.*
!apps/mobile/.env
