{
  "name": "@iching-oracle/iching-data",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:data && tsc && node ../../scripts/copy-generated.mjs",
    "build:data": "node ../../scripts/build-hexagrams.mjs && node ../../scripts/build-hexagram-commentary.mjs && node ../../scripts/build-trigrams.mjs && node ../../scripts/build-mutation-rules.mjs",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
