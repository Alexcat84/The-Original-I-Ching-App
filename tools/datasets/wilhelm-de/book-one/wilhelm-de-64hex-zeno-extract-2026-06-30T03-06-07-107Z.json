    "33": {
      "zenoPath": "/Philosophie/M/Anonym/I+Ging+-+Buch+der+Wandlungen/Erstes+Buch%3A+Der+Text/Zweite+Abteilung/33.+Dun+-+Der+R%C3%BCckzug",
