    "21": {
      "zenoPath": "/Philosophie/M/Anonym/I+Ging+-+Buch+der+Wandlungen/Erstes+Buch%3A+Der+Text/Erste+Abteilung/21.+Sch%C3%AF+Ho+-+Das+Durchbeissen",
